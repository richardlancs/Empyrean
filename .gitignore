# Secrets: never commit keys or connection strings (AGENTS.md rule 9).
# .env.example (names only, empty values) stays tracked.
.env
.env.*
!.env.example

# Python and tool caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Model weights: downloaded at runtime, never committed (AGENTS.md rule 7).
# Ultralytics saves yolo*.pt into the working directory.
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.task
# Piper voices fetched by `python -m audio.fetch_voices` (about 470 MB).
audio/voice_models/
# Text encoder that the demo prompt build downloads (600 MB).
mobileclip_*.ts

# Large recordings (AGENTS.md rule 10). The short recorded clip that the
# vision fake plays (AGENTS.md rule 3) is allowed: keep it <= 20 s and <= 10 MB.
*.mp4
*.avi
*.mov
!fakes/vision/*.mp4
!fakes/vision/*.avi
!fakes/vision/*.mov

# Local working files
scratch/
.claude/settings.local.json
.claude/worktrees/
.playwright-mcp/

# OS and editors
.DS_Store
.idea/
.vscode/

# Demo checkpoint manifest and partial copies (distributed with the release, never committed).
vision/models/training-status.json
vision/models/*.partial
